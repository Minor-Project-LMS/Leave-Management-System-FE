# Development Environment Configuration
# This file is used when running: npm run dev

# API Configuration
# In development, we use relative path which will be proxied by Vite
VITE_API_BASE_URL=/api/v1

# The actual backend server that Vite will proxy requests to
# Update this to match your local backend server
VITE_API_TARGET=http://localhost:8080

# Feature Flags
# Set to 'true' to use mock data instead of real API calls
# Useful when backend is not available
VITE_USE_MOCK_DATA=false

# Application Configuration
VITE_APP_NAME=Leave Management System (Dev)
VITE_API_TIMEOUT=30000