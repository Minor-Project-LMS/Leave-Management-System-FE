# API Configuration
# Base URL for the backend API (without trailing slash)
# In production, this should be the actual backend API URL
# Example: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=/api/v1

# API Proxy Target (for development only)
# Used by Vite dev server proxy to forward API requests
# This is only used in development mode
VITE_API_TARGET=http://localhost:8081

# Feature Flags
# Set to 'true' to use mock data instead of real API calls
# Useful for development and testing without a backend
VITE_USE_MOCK_DATA=false

# Application Configuration
# Application name/title
VITE_APP_NAME=Leave Management System

# Timeout settings (in milliseconds)
# API request timeout duration
VITE_API_TIMEOUT=30000